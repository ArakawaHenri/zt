[Unit]
Description=TrustAgent trustservice daemon
Requires=zt-net.service
Wants=network.target
After=zt-net.service network.target

[Service]
Type=simple
User=root
NoNewPrivileges=true
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_PTRACE
WorkingDirectory=/opt/apps/com.qianxin.trustagent/files/bin/
ExecStart=/opt/apps/com.qianxin.trustagent/files/bin/trustservice --nofork
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
