[Unit]
Description=TrustAgent trustdservice daemon
Wants=network.target
After=network.target network-online.target

[Service]
Type=simple
NoNewPrivileges=true
WorkingDirectory=/opt/apps/com.qianxin.trustagent/files/bin/
ExecStart=/opt/apps/com.qianxin.trustagent/files/bin/trustdservice
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
