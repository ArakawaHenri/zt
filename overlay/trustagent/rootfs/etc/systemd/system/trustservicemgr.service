[Unit]
Description=TrustAgent service manager
Requires=zt-net.service
After=zt-net.service network.target

[Service]
Type=simple
NoNewPrivileges=true
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_PTRACE
WorkingDirectory=/opt/apps/com.qianxin.trustagent/files/bin/
ExecStartPre=/bin/rm -f /run/trustservicemgr.pid
ExecStart=/opt/apps/com.qianxin.trustagent/files/bin/trustservicemgr
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
