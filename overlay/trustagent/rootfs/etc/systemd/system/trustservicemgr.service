[Unit]
Description=TrustAgent service manager
After=network.target

[Service]
NoNewPrivileges=true
PIDFile=/var/run/trustservicemgr.pid
ExecStartPre=/bin/rm -f /var/run/trustservicemgr.pid
ExecStart=/opt/apps/com.qianxin.trustagent/files/bin/trustservicemgr
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
