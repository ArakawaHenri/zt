[Unit]
Description=KasmVNC web desktop on Openbox
Requires=zt-net.service
After=zt-net.service network-online.target

[Service]
Type=simple
User=kasm-user
NoNewPrivileges=true
PassEnvironment=ZT_AUTH VNC_PW TZ
Environment=HOME=/home/kasm-user
Environment=USER=kasm-user
Environment=LOGNAME=kasm-user
Environment=DISPLAY=:1
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
WorkingDirectory=/home/kasm-user
ExecStart=/usr/local/bin/zt-kasmvnc.sh
ExecStopPost=-/usr/bin/vncserver -kill :1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
