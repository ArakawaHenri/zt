[Unit]
Description=Sangfor VPN client session on the KasmVNC desktop
Requires=zt-net.service
After=zt-net.service kasmvnc.service network-online.target
Wants=kasmvnc.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
# The session script starts the vendor daemons as root and runs the desktop GUI
# as kasm-user with zero capabilities and NoNewPrivs. Both display readiness
# and optional EasyConnect config sync run as kasm-user via setpriv.
User=root
NoNewPrivileges=true
Environment=HOME=/root
Environment=DISPLAY=:1
Environment=LANG=en_US.UTF-8
ExecStartPre=/usr/bin/setpriv --reuid kasm-user --regid kasm-user --init-groups --no-new-privs /usr/bin/env HOME=/home/kasm-user DISPLAY=:1 /bin/sh -c 'until /usr/bin/xdpyinfo -display :1 >/dev/null 2>&1; do sleep 1; done'
ExecStartPre=/usr/bin/setpriv --reuid kasm-user --regid kasm-user --init-groups --no-new-privs /usr/bin/env HOME=/home/kasm-user /bin/sh -c '[ ! -x /usr/local/bin/zt-conf.sh ] || /usr/local/bin/zt-conf.sh init'
ExecStart=/usr/local/bin/zt-sangfor-session.sh
ExecStopPost=-/usr/bin/setpriv --reuid kasm-user --regid kasm-user --init-groups --no-new-privs /usr/bin/env HOME=/home/kasm-user /bin/sh -c '[ ! -x /usr/local/bin/zt-conf.sh ] || /usr/local/bin/zt-conf.sh sync'
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
StandardOutput=append:/var/log/zt-sangfor.log
StandardError=append:/var/log/zt-sangfor.log

[Install]
WantedBy=multi-user.target
