#!/bin/sh
# Container sysctl wrapper for aTrust: allow utun<N>.route_localnet=1 to succeed
# if the kernel already has the value set (e.g. via rootless --sysctl default)
# or when /proc/sys/net/ipv4/conf is writable. Never relaxes eth*/all/default.
if [ "$#" -eq 2 ] && [ "$1" = "-w" ]; then
    case "$2" in
        net.ipv4.conf.utun*[!0-9]*.route_localnet=1) ;;
        net.ipv4.conf.utun[0-9]*.route_localnet=1)
            key=${2%=1}
            if [ "1" = "$(/usr/sbin/sysctl.real -n "$key" 2>/dev/null)" ] \
                || /usr/sbin/sysctl.real "$@" 2>/dev/null; then
                exit 0
            fi
            exit 1
            ;;
    esac
fi
exec /usr/sbin/sysctl.real "$@"
